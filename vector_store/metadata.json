[{"chunk_id": "3f7b5b02-0b8c-4d15-80d9-a4d9557ca916", "source": "inventory_policy.pdf", "page": 1, "text": "Inventory Policy", "chunk_index": 0}, {"chunk_id": "9d494554-d3b6-487d-ad32-b1795a20524c", "source": "inventory_policy.pdf", "page": 2, "text": "Reorder thresholds: maintain minimum stock levels. Approval required for orders over $10,000.", "chunk_index": 0}, {"chunk_id": "38844579-478a-4cd8-b1b8-758e18adab79", "source": "inventory_policy.pdf", "page": 3, "text": "Maximum stock levels: Do not exceed max capacity. Stock variance rules and cycle counts monthly.", "chunk_index": 0}, {"chunk_id": "6b9fe6ec-e8cf-4ed1-a32b-b4611595577d", "source": "operations_sop.pdf", "page": 1, "text": "Operations SOP", "chunk_index": 0}, {"chunk_id": "6215e020-b566-4d08-9f22-9dfd1a68d7c0", "source": "operations_sop.pdf", "page": 2, "text": "Inventory procedures: receiving, inspection, reconciliation steps.", "chunk_index": 0}, {"chunk_id": "3be3c886-340c-4405-864a-25782d9a7582", "source": "operations_sop.pdf", "page": 3, "text": "Escalation procedures and purchasing procedures for emergency restocks.", "chunk_index": 0}, {"chunk_id": "f8805066-a95d-4679-b46e-e533aac40652", "source": "vendor_policy.pdf", "page": 1, "text": "Vendor Policy", "chunk_index": 0}, {"chunk_id": "c8c3033c-fe32-4918-94ca-9ac851bc08b2", "source": "vendor_policy.pdf", "page": 2, "text": "Vendor pricing rules: require three quotes for purchases over $5,000.", "chunk_index": 0}, {"chunk_id": "3d6416af-3c0b-480b-9627-057960fedf4e", "source": "vendor_policy.pdf", "page": 3, "text": "Vendor evaluation: annual reviews, contract requirements, procurement approval process.", "chunk_index": 0}]